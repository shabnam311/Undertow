# Undertow Environment Variables Example

# Application Setup
NODE_ENV=development
PORT=3001

# Frontend API URL (for apps/web)
VITE_API_URL=http://localhost:3001

# Database (Neon Serverless Postgres / pgvector)
DATABASE_URL=postgresql://user:password@ep-sample-123.ap-southeast-1.aws.neon.tech/undertow?sslmode=require

# Authentication (Cryptographic HMAC-SHA256 Session Tokens)
# Generate a cryptographically secure 32-byte secret in production: openssl rand -hex 32
AUTH_SECRET=your_32_byte_hmac_secret_here

# Razorpay Webhook Security
# The secret configured in your Razorpay Merchant Dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Agent Orchestration (Inngest Serverless Workflow Engine)
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Providers (Groq LPU Primary + Anthropic Claude Haiku Fallback)
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...

# Communication Channels (Live Email + Test/Simulated SMS & WhatsApp)
RESEND_API_KEY=re_...
MSG91_API_KEY=...
SARVAM_API_KEY=...

# Feature Flags
ENABLE_SHADOW_MODE=false
